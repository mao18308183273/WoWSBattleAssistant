<Window x:Class="WoWSBattleAssistant.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="640" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" Background="#FFF5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="16" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- AI 提供方 -->
                <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="AI 模型" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <RadioButton x:Name="RbGlm" Content="智谱 GLM-4V（国内免费额度，中文好）" Margin="0,4" GroupName="Ai"/>
                        <RadioButton x:Name="RbQwen" Content="通义千问 VL（阿里，免费额度）" Margin="0,4" GroupName="Ai"/>
                        <RadioButton x:Name="RbDeepSeek" Content="DeepSeek 视觉（网页版逆向，需登录态，免费）" Margin="0,4" GroupName="Ai"/>

                        <TextBlock Text="GLM API Key" Margin="0,12,0,4" FontSize="12"/>
                        <PasswordBox x:Name="PbGlmKey" Margin="0,0,0,6"/>
                        <TextBlock Text="GLM 模型" Margin="0,4,0,4" FontSize="12"/>
                        <ComboBox x:Name="CbGlmModel" Margin="0,0,0,6"/>
                        <TextBlock Text="获取 Key: 注册 https://bigmodel.cn 后在控制台创建 API Key" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>

                        <TextBlock Text="通义 API Key" Margin="0,12,0,4" FontSize="12"/>
                        <PasswordBox x:Name="PbQwenKey" Margin="0,0,0,6"/>
                        <TextBlock Text="通义 模型" Margin="0,4,0,4" FontSize="12"/>
                        <ComboBox x:Name="CbQwenModel" Margin="0,0,0,6"/>
                        <TextBlock Text="获取 Key: 注册 https://dashscope.aliyun.com 后在控制台创建 API Key" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>

                        <TextBlock Text="DeepSeek Token（authorization，去掉 Bearer 前缀）" Margin="0,12,0,4" FontSize="12"/>
                        <PasswordBox x:Name="PbDeepSeekToken" Margin="0,0,0,6"/>
                        <TextBlock Text="DeepSeek Cookie（整行）" Margin="0,4,0,4" FontSize="12"/>
                        <TextBox x:Name="TxtDeepSeekCookie" Margin="0,0,0,6" AcceptsReturn="True" TextWrapping="Wrap" Height="50" VerticalScrollBarVisibility="Auto" FontSize="11"/>
                        <TextBlock Text="获取方式：浏览器登录 chat.deepseek.com → F12 → Network → 点任意 api/v0 请求 → Headers → 复制 authorization(去 Bearer ) 与 cookie 整行。Token 过期需重新复制。本功能依赖本机 Node.js（用于 PoW 求解）。" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 战舰数据 -->
                <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="战舰知识库" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <TextBlock Text="战舰数据 JSON 路径" FontSize="12" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtShipDataPath" Grid.Column="0" Margin="0,0,6,0"/>
                            <Button x:Name="BtnBrowse" Grid.Column="1" Content="浏览..." Padding="12,4" Click="BtnBrowse_Click"/>
                        </Grid>
                        <TextBlock x:Name="TxtShipCount" Text="" FontSize="11" Foreground="Gray" Margin="0,4,0,0"/>
                        <Button x:Name="BtnReload" Content="重新加载知识库" Padding="12,4" Margin="0,8,0,0" HorizontalAlignment="Left" Click="BtnReload_Click"/>

                        <TextBlock Text="游戏服务器（用于玩家战绩查询）" Margin="0,12,0,4" FontSize="12"/>
                        <ComboBox x:Name="CbServer" Margin="0,0,0,6"/>
                        <TextBlock Text="用于在 wows.mgaia.top 后端查询玩家战绩以评估威胁。国服选 cn。" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 小地图区域 -->
                <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="小地图区域" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtRegion" Text="未设置" FontSize="12" Foreground="Gray" Margin="0,0,0,8"/>
                        <Button x:Name="BtnSelectRegion" Content="框选小地图位置" Padding="12,4" HorizontalAlignment="Left" Click="BtnSelectRegion_Click"/>
                        <TextBlock Text="提示：点击后进入全屏框选模式，按住鼠标左键拖动框选游戏小地图区域。" FontSize="11" Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 系统提示词 -->
                <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="自定义系统提示词（可选，留空用默认）" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <TextBox x:Name="TxtSystemPrompt" AcceptsReturn="True" TextWrapping="Wrap" Height="100"
                                 VerticalScrollBarVisibility="Auto" FontSize="12"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="取消" Padding="20,6" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnSave" Content="保存" Padding="20,6" IsDefault="True" Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
